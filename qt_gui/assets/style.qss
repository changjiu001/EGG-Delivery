/* Comfortable dark theme — GitHub Dark / VS Code inspired */

* {
    color: #e6edf3;
    font-size: 14px;
}

QMainWindow, QDialog, QWidget {
    background: #0d1117;
}

QLabel {
    background: transparent;
    color: #e6edf3;
}

#leftPanel {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
}

#titleLabel {
    color: #f0f6fc;
    font-size: 22px;
    font-weight: 700;
}

#sectionLabel, #stickerPanelTitle {
    color: #8b949e;
    font-weight: 600;
    font-size: 12px;
    text-transform: none;
}

QTabWidget::pane {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 10px;
    top: -1px;
}

QTabBar::tab {
    color: #8b949e;
    background: #161b22;
    border: 1px solid #30363d;
    padding: 8px 20px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:hover {
    color: #c9d1d9;
    background: #21262d;
}

QTabBar::tab:selected {
    color: #f0f6fc;
    background: #0d1117;
    border-bottom-color: #0d1117;
    font-weight: 600;
}

QTextBrowser, QTableWidget, QListWidget, QTreeView, QListView,
QLineEdit, QSpinBox, QFileDialog, QMessageBox {
    color: #e6edf3;
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    selection-background-color: #264f78;
    selection-color: #f0f6fc;
}

QTextBrowser {
    background: #0d1117;
    padding: 10px;
    border: 1px solid #21262d;
}

QLineEdit, QSpinBox {
    padding: 8px 10px;
    background: #0d1117;
}

QLineEdit:focus, QSpinBox:focus, QListWidget:focus, QTableWidget:focus {
    border-color: #388bfd;
}

QLineEdit::placeholder {
    color: #6e7681;
}

QListWidget {
    outline: none;
    padding: 4px;
    background: #0d1117;
}

QListWidget::item {
    padding: 10px;
    border-radius: 8px;
    color: #c9d1d9;
}

QListWidget::item:hover {
    background: #21262d;
}

QListWidget::item:selected {
    background: #264f78;
    color: #f0f6fc;
}

QHeaderView::section {
    color: #8b949e;
    background: #161b22;
    border: 0;
    border-right: 1px solid #21262d;
    border-bottom: 1px solid #30363d;
    padding: 8px;
    font-weight: 600;
    font-size: 12px;
}

QTableWidget {
    gridline-color: #21262d;
    alternate-background-color: #161b22;
}

QTableWidget::item {
    padding: 4px 6px;
}

QPushButton {
    color: #f0f6fc;
    background: #21262d;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background: #30363d;
    border-color: #484f58;
}

QPushButton:pressed {
    background: #161b22;
}

QPushButton:disabled {
    color: #484f58;
    background: #161b22;
    border-color: #21262d;
}

/* Primary action buttons */
QPushButton#startButton,
QPushButton#sendButton {
    background: #238636;
    border-color: #2ea043;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#startButton:hover,
QPushButton#sendButton:hover {
    background: #2ea043;
    border-color: #3fb950;
}

QPushButton#startButton:pressed,
QPushButton#sendButton:pressed {
    background: #196c2e;
}

QPushButton#stopButton {
    background: #da3633;
    border-color: #f85149;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#stopButton:hover {
    background: #f85149;
    border-color: #ff7b72;
}

QPushButton#stopButton:pressed {
    background: #b62324;
}

#stickerPanel {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
}

QToolButton#stickerButton {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 12px;
    padding: 6px;
}

QToolButton#stickerButton:hover {
    background: #21262d;
    border-color: #388bfd;
}

QProgressBar {
    color: #c9d1d9;
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    text-align: center;
    font-weight: 600;
    font-size: 11px;
}

QProgressBar::chunk {
    background: #238636;
    border-radius: 5px;
}

QStatusBar {
    color: #8b949e;
    background: #161b22;
    border-top: 1px solid #21262d;
}

QToolTip {
    color: #e6edf3;
    background: #21262d;
    border: 1px solid #30363d;
    padding: 4px 8px;
}

QScrollBar:vertical {
    background: #0d1117;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #484f58;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #0d1117;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #484f58;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
